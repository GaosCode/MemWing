{
  "id": "memwing",
  "name": "MemWing",
  "version": "0.1.1",
  "entry": "dist/index.js",
  "openclaw": {
    "supportedVersions": ">=2026.4.24 <2027.0.0"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "memwingBaseUrl": {
        "type": "string",
        "minLength": 1
      },
      "workspaceId": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "defaultScope": {
        "type": "object",
        "properties": {
          "project_memory_space_id": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "thread_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "shared_group_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "project_memory_space_id"
        ],
        "additionalProperties": false
      },
      "modelRuntime": {
        "type": "string",
        "enum": [
          "openclaw"
        ]
      },
      "models": {
        "type": "object",
        "properties": {
          "pageMemory": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "longTermFilter": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "graphitiExtraction": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "graphitiEmbedding": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "graphitiRerank": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidenceEmbedding": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "modelTimeoutSeconds": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "additionalProperties": false
  },
  "permissions": {
    "allowConversationAccess": true,
    "network": [
      "http://localhost:*",
      "https://localhost:*"
    ]
  },
  "contextEngines": [
    "memwing"
  ],
  "tools": [
    "memwing_search_memory",
    "memwing_get_memory",
    "memwing_explain_memory",
    "memwing_search_sources",
    "memwing_get_project_context"
  ]
}
